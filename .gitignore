# Config with secrets.
# The trailing glob is load-bearing: it covers backups and editor copies such
# as config.json.bak-<date>, which hold the same live credentials as the file
# itself. An exact-path rule ignores the original while leaving every copy of
# it stageable, which is the more dangerous half.
config/config.json*

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# Logs
data/logs/*.log

# Runtime state
data/state/status.json
data/state/reload.trigger
data/state/sab_settings.json
data/state/preview_status.json

# Captures - debug screenshots/recordings, never committed
captures/

# IDE
.vscode/
.idea/

# Claude Code - local only. The guard hook is registered at machine (user) level,
# not per-repo - never commit anything under .claude/ in this repo.
.claude/
